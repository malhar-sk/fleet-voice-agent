# Copy to .env and fill in what you have. Everything works with all of these empty.

# LLM: with a key, the voice app uses Claude with native tool use; empty = offline rules router.
ANTHROPIC_API_KEY=
LLM_BACKEND=auto
LLM_MODEL=claude-haiku-5-5

# Telegram voice notes for alerts (empty = the .ogg is saved in alerts_out/ and logged)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Language of the alert voice note: en | hi | mr
ALERT_LANG=en

# Host ports (container ports are fixed). On your own laptop you can use 3000 / 7860.
BIND_ADDR=127.0.0.1
GRAFANA_PORT=13000
APP_PORT=17860
N8N_PORT=15678
VM_PORT=18428
GRAFANA_ADMIN_PASSWORD=admin

# Simulator
PUSH_INTERVAL=5
FLAP_PROB_PER_MIN=0.01
BREACH_BURST_PROB_PER_MIN=0.05

# Speech-to-text threads (1 = friendly to a small shared box; 4 is faster on a laptop)
STT_THREADS=1
